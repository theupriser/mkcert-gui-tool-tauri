{
  "productName": "mkcert-gui-tool",
  "version": "1.0.0",
  "identifier": "com.mkcert.gui.tool",
  "app": {
    "withGlobalTauri": true, 
    "windows": [
      {
        "title": "MKCert Auto-Generator",
        "width": 600,
        "height": 720,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["deb", "rpm"],
    "category": "DeveloperTool",
    "shortDescription": "A tiny cross-platform local SSL certificate manager using mkcert",
    "longDescription": "An efficient alternative to Electron that utilizes systemic engine layouts to trust, generate, and track local workspace certificate records automatically."
  }
}
